# Installed to /etc/apiagent/consumer.env by deploy/bootstrap.sh.
# Read by deploy/systemd/consumer.service.

# Interface uvicorn binds to. The API has no authentication, so keep it off the
# public internet: bind the Tailscale address, which deploy/set-tailscale-host.sh
# fills in for you. 127.0.0.1 also works if only this VM's agent calls the API.
BIND_HOST=127.0.0.1

PORT=8002

# The operation service (ApiAgentService1), which runs on the other VM. This is the only
# link between the two services: ApiAgentService2 calls it over HTTP and installs nothing
# from it. Use the other VM's Tailscale name and its API port, not the agent port.
OPERATION_BASE_URL=http://apiagent-service1:8001
