# Copy to .env. `agentkit dev` sets AGENT_REGISTRY and AGENT_SHARED_TOKEN for you.
NVIDIA_API_KEY=
# NIM_MODEL=moonshotai/kimi-k3

# Fine-grained token with access to prangunj23/ApiAgentService2 (Contents and Pull requests: read and write)
# and prangunj23/ApiAgentService1 (Contents: read).
GITHUB_TOKEN=

# Email, used by send_email
EMAIL_TO=
# EMAIL_PROVIDER=resend
# EMAIL_FROM=
RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# AGENT_DATA_DIR=~/.apiagent/service2
# UI_ORIGINS=http://localhost:5173
# AUTO_APPROVE_LEARNINGS=false
